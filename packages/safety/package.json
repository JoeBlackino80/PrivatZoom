{
  "name": "@zavoj/safety",
  "version": "0.1.0",
  "description": "ZÁVOJ — anti-abuse vrstva (vekové brány, súhlas s nahrávaním, report/block). Podmienka pre store review aj B2B.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
